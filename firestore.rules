rules_version = '2';

// One household, two accounts. Reading is shared; writes that represent one
// person are tied to that person's Firebase account.
service cloud.firestore {
  match /databases/{database}/documents {
    function isHer() {
      return request.auth != null && request.auth.uid == 'cwQndCjlRlcaHasR1xzp9EYICFz2';
    }

    function isHim() {
      return request.auth != null && request.auth.uid == 'oLSxADOwjqS04hSS2aHGOcvozmz2';
    }

    function isMember() {
      return isHer() || isHim();
    }

    function inHousehold(householdId) {
      return isMember() && householdId == 'oLSxADOwjqS04hSS2aHGOcvozmz2';
    }

    function mySide() {
      return isHer() ? 'her' : 'him';
    }

    function otherSide() {
      return isHer() ? 'him' : 'her';
    }

    function ownsSide(person) {
      return person == mySide();
    }

    function shortText(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    match /households/{householdId}/profiles/{profileId} {
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId)
        && profileId == 'couple'
        && shortText(request.resource.data.sunName, 24)
        && shortText(request.resource.data.moonName, 24)
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }

    match /households/{householdId}/locations/{person} {
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId) && ownsSide(person)
        && request.resource.data.person == person
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
      allow delete: if inHousehold(householdId) && ownsSide(person);
    }

    match /households/{householdId}/places/{placeId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.person == mySide()
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.radius is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.radius >= 50 && request.resource.data.radius <= 1000
        && shortText(request.resource.data.label, 40)
        && shortText(request.resource.data.statusText, 90)
        && shortText(request.resource.data.emoji, 16)
        && request.resource.data.preset in ['home', 'work', 'school', 'errands', 'custom']
        && (!request.resource.data.keys().hasAny(['announceLeave']) || request.resource.data.announceLeave is bool);
      allow update: if inHousehold(householdId)
        && resource.data.person == mySide()
        && request.resource.data.person == resource.data.person
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.radius is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.radius >= 50 && request.resource.data.radius <= 1000
        && shortText(request.resource.data.label, 40)
        && shortText(request.resource.data.statusText, 90)
        && shortText(request.resource.data.emoji, 16)
        && request.resource.data.preset in ['home', 'work', 'school', 'errands', 'custom']
        && (!request.resource.data.keys().hasAny(['announceLeave']) || request.resource.data.announceLeave is bool);
      allow delete: if inHousehold(householdId) && resource.data.person == mySide();
    }

    match /households/{householdId}/pins/{pinId} {
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId)
        && pinId == 'fridge'
        && shortText(request.resource.data.text, 240)
        && shortText(request.resource.data.emoji, 16)
        && request.resource.data.updatedBy == mySide()
        && request.resource.data.updatedAt is int;
      allow delete: if inHousehold(householdId) && pinId == 'fridge';
    }

    match /households/{householdId}/statuses/{person} {
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId) && ownsSide(person)
        && request.resource.data.person == person
        && shortText(request.resource.data.text, 240)
        && shortText(request.resource.data.category, 40)
        && shortText(request.resource.data.emoji, 16)
        && (!request.resource.data.keys().hasAny(['energy']) || shortText(request.resource.data.energy, 40))
        && (!request.resource.data.keys().hasAny(['arrival']) || shortText(request.resource.data.arrival, 40));
      allow delete: if inHousehold(householdId) && ownsSide(person);
    }

    match /households/{householdId}/presence/{person} {
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId) && ownsSide(person)
        && request.resource.data.person == person;
      allow delete: if inHousehold(householdId) && ownsSide(person);
    }

    match /households/{householdId}/pushSubs/{person} {
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId) && ownsSide(person)
        && request.resource.data.person == person
        && request.resource.data.subscription is map;
      // The delivery worker may remove either side's expired browser endpoint.
      allow delete: if inHousehold(householdId);
    }

    match /households/{householdId}/items/{itemId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.addedBy == mySide()
        && shortText(request.resource.data.title, 180);
      allow update: if inHousehold(householdId)
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.type == resource.data.type
        && shortText(request.resource.data.title, 180)
        && (!request.resource.data.keys().hasAny(['due']) || shortText(request.resource.data.due, 10))
        && (!request.resource.data.keys().hasAny(['aisle']) || shortText(request.resource.data.aisle, 40))
        && (!request.resource.data.keys().hasAny(['recurrence']) || request.resource.data.recurrence in ['once', 'daily', 'weekly', 'monthly']);
      allow delete: if inHousehold(householdId);
    }

    match /households/{householdId}/notes/{noteId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.sender == mySide()
        && request.resource.data.from == mySide()
        && request.resource.data.recipient == otherSide()
        && request.resource.data.to == otherSide()
        && shortText(request.resource.data.body, 500);
      allow update: if inHousehold(householdId)
        && request.resource.data.sender == resource.data.sender
        && request.resource.data.recipient == resource.data.recipient
        && request.resource.data.createdAt == resource.data.createdAt
        && shortText(request.resource.data.body, 500)
        && (request.resource.data.body == resource.data.body
          || (resource.data.sender == mySide()
            && resource.data.createdAt is int
            && request.time.toMillis() <= resource.data.createdAt + 86400000
            && request.resource.data.editedAt is int
            && request.resource.data.editedAt >= resource.data.createdAt
            && request.resource.data.editedAt <= request.time.toMillis() + 60000));
      allow delete: if inHousehold(householdId);
    }

    match /households/{householdId}/reminders/{reminderId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.sender == mySide()
        && request.resource.data.from == mySide()
        && request.resource.data.recipient == otherSide()
        && request.resource.data.to == otherSide()
        && shortText(request.resource.data.title, 180)
        && shortText(request.resource.data.note, 500);
      // Reminders created before dueAt existed have no such field, and comparing
      // against a missing key is an error, which denies the write. That made
      // "mark all seen" silently fail forever on the oldest reminders.
      allow update: if inHousehold(householdId)
        && request.resource.data.sender == resource.data.sender
        && request.resource.data.recipient == resource.data.recipient
        && request.resource.data.title == resource.data.title
        && (!('dueAt' in resource.data) || request.resource.data.dueAt == resource.data.dueAt)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if inHousehold(householdId);
    }

    match /households/{householdId}/dates/{dateId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && (request.resource.data.addedBy == mySide()
            || (request.resource.data.imported == true && dateId.matches('old-list-.*')))
        && shortText(request.resource.data.title, 180)
        && shortText(request.resource.data.note, 500);
      allow update: if inHousehold(householdId)
        && request.resource.data.addedBy == resource.data.addedBy
        && shortText(request.resource.data.title, 180)
        && shortText(request.resource.data.note, 500)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if inHousehold(householdId);
    }

    match /households/{householdId}/help/{requestId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.from == mySide()
        && request.resource.data.to in [mySide(), otherSide()]
        && shortText(request.resource.data.title, 180)
        && shortText(request.resource.data.note, 500)
        && (!request.resource.data.keys().hasAny(['urgent']) || request.resource.data.urgent is bool);
      allow update: if inHousehold(householdId)
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.title == resource.data.title
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if inHousehold(householdId);
    }

    match /households/{householdId}/focus/{person} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId) && ownsSide(person)
        && request.resource.data.person == person
        && shortText(request.resource.data.label, 100)
        && request.resource.data.updatedAt is int;
      allow update: if inHousehold(householdId) && ownsSide(person)
        && request.resource.data.person == person
        && (!request.resource.data.keys().hasAny(['label']) || shortText(request.resource.data.label, 100))
        && request.resource.data.updatedAt is int;
      allow delete: if inHousehold(householdId) && ownsSide(person);
    }

    match /households/{householdId}/memories/{memoryId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.addedBy == mySide()
        && shortText(request.resource.data.text, 500)
        && (!request.resource.data.keys().hasAny(['memoryDate']) || (request.resource.data.memoryDate is string && request.resource.data.memoryDate.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')))
        && (!request.resource.data.keys().hasAny(['photo']) || shortText(request.resource.data.photo, 650000))
        && (!request.resource.data.keys().hasAny(['thumb']) || shortText(request.resource.data.thumb, 30000))
        && (!request.resource.data.keys().hasAny(['hasPhoto']) || request.resource.data.hasPhoto is bool)
        && request.resource.data.createdAt is int;
      // An owner may move an old inline photo out of this hot collection. The
      // memory itself stays immutable; only its image bookkeeping can change.
      allow update: if inHousehold(householdId)
        && resource.data.addedBy == mySide()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'thumb', 'hasPhoto'])
        && (!request.resource.data.keys().hasAny(['photo']) || shortText(request.resource.data.photo, 650000))
        && (!request.resource.data.keys().hasAny(['thumb']) || shortText(request.resource.data.thumb, 30000))
        && (!request.resource.data.keys().hasAny(['hasPhoto']) || request.resource.data.hasPhoto is bool);
      allow delete: if inHousehold(householdId);
    }

    // Guess rows are private. Only the count and final result are shared.
    match /households/{householdId}/wordPuzzles/{day} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}(-tie-[0-9]+)?') && request.resource.data.day == day
        && request.resource.data.keys().hasOnly(['day','word','opensAt','closesAt','week','theme','difficulty','catalogVersion','entryId'])
        && request.resource.data.word.matches('[a-z]{5}')
        && request.resource.data.opensAt is int && request.resource.data.closesAt is int
        && ((day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.closesAt - request.resource.data.opensAt >= 82800000
          && request.resource.data.closesAt - request.resource.data.opensAt <= 90000000)
          || (request.resource.data.week is string && day.matches(request.resource.data.week + '-tie-[0-9]+') && request.resource.data.closesAt == 4102444800000));
      allow update, delete: if false;
    }
    match /households/{householdId}/wordGames/{id} {
      function valid(g) {
        let p = get(/databases/$(database)/documents/households/$(householdId)/wordPuzzles/$(g.day)).data;
        let n = g.guesses.size();
        return g.keys().hasOnly(['day','person','guesses','won','done','updatedAt'])
          && g.person == mySide() && id == g.day + '-' + mySide()
          && g.guesses is list && n >= 1 && n <= 5 && g.guesses.toSet().size() == n
          && g.guesses[n-1].matches('[a-z]{5}')
          && request.time.toMillis() >= p.opensAt && request.time.toMillis() < p.closesAt
          && (!g.day.matches('.*-tie-.*') || !exists(/databases/$(database)/documents/households/$(householdId)/wordDuelEnds/$(g.day)))
          && g.won == (g.guesses[n-1] == p.word)
          && g.done == (g.won || n == 5) && g.updatedAt is int;
      }
      function appended(a,b) {
        let n = a.guesses.size();
        return !a.done && b.day == a.day && b.person == a.person
          && b.guesses.size() == n+1
          && b.guesses[0] == a.guesses[0]
          && (n<2 || b.guesses[1] == a.guesses[1])
          && (n<3 || b.guesses[2] == a.guesses[2])
          && (n<4 || b.guesses[3] == a.guesses[3]);
      }
      // Reveal only a specific finished board, and only after this viewer has
      // finished the same puzzle. Collection queries remain owner-only.
      function bothFinished() {
        return resource.data.done == true
          && resource.data.person in ['her','him']
          && id == resource.data.day + '-' + resource.data.person
          && get(/databases/$(database)/documents/households/$(householdId)/wordGames/$(resource.data.day + '-' + mySide())).data.done == true;
      }
      allow get: if inHousehold(householdId) && (id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}(-tie-[0-9]+)?-' + mySide()) || bothFinished());
      allow list: if inHousehold(householdId) && resource.data.person == mySide();
      allow create: if inHousehold(householdId) && valid(request.resource.data) && request.resource.data.guesses.size() == 1;
      allow update: if inHousehold(householdId) && valid(request.resource.data) && appended(resource.data,request.resource.data);
      allow delete: if false;
    }
    match /households/{householdId}/wordResults/{id} {
      function matchesGame(g) {
        let game = getAfter(/databases/$(database)/documents/households/$(householdId)/wordGames/$(id)).data;
        return g.keys().hasOnly(['day','person','attempts','done','won','updatedAt'])
          && g.person == mySide() && id == g.day + '-' + mySide()
          && g.day == game.day && g.person == game.person && g.attempts == game.guesses.size()
          && g.done == game.done && g.won == game.won && g.updatedAt == game.updatedAt;
      }
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId) && matchesGame(request.resource.data);
      allow delete: if false;
    }

    match /households/{householdId}/timedPuzzles/{id} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.keys().hasOnly(['day','type','hard','size','grid','entries','opensAt','closesAt','theme','themeId','difficulty','catalogVersion'])
        && request.resource.data.theme is string && request.resource.data.theme.size() <= 80
        && request.resource.data.difficulty in ['normal','hard'] && request.resource.data.catalogVersion is int
        && request.resource.data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}(-tie-[0-9]+)?')
        && request.resource.data.type in ['search','crossword']
        && id == request.resource.data.day + '-' + request.resource.data.type
        && request.resource.data.hard is bool && request.resource.data.size in [9,10,11,12]
        && request.resource.data.grid is string && request.resource.data.grid.matches('[A-Z#]+')
        && request.resource.data.grid.size() == request.resource.data.size * request.resource.data.size
        && request.resource.data.entries is list && request.resource.data.entries.size() >= 4 && request.resource.data.entries.size() <= 10
        && request.resource.data.opensAt is int && request.resource.data.closesAt is int;
      allow update, delete: if false;
    }
    function timedDuration(kind) { return 120000; }
    function samePrefix(a,b) {
      return (a.size()<1 || a[0]==b[0]) && (a.size()<2 || a[1]==b[1])
        && (a.size()<3 || a[2]==b[2]) && (a.size()<4 || a[3]==b[3])
        && (a.size()<5 || a[4]==b[4]) && (a.size()<6 || a[5]==b[5])
        && (a.size()<7 || a[6]==b[6]) && (a.size()<8 || a[7]==b[7])
        && (a.size()<9 || a[8]==b[8]) && (a.size()<10 || a[9]==b[9]);
    }
    match /households/{householdId}/timedGames/{id} {
      function allowed(g) {
        return g.keys().hasOnly(['day','type','person','startedAt','finishedAt','solved','foundAt','done','complete','total','closesAt'])
          && g.person == mySide() && g.type in ['search','crossword']
          && id == g.day + '-' + g.type + '-' + mySide()
          && g.startedAt is timestamp && g.solved is list && g.foundAt is list
          && g.solved.size() == g.foundAt.size() && g.solved.size() <= 10
          && g.done is bool && g.complete is bool && g.total is int && g.closesAt is int
          && (!g.day.matches('.*-tie-.*') || !exists(/databases/$(database)/documents/households/$(householdId)/wordDuelEnds/$(g.day)));
      }
      function start(g) {
        let p = get(/databases/$(database)/documents/households/$(householdId)/timedPuzzles/$(g.day + '-' + g.type)).data;
        return allowed(g) && g.startedAt == request.time && g.finishedAt == null
          && g.solved.size() == 0 && !g.done && !g.complete && g.total == p.entries.size() && g.closesAt == p.closesAt
          && request.time.toMillis() >= p.opensAt && request.time.toMillis() < p.closesAt;
      }
      function move(a,b) {
        let p = get(/databases/$(database)/documents/households/$(householdId)/timedPuzzles/$(b.day + '-' + b.type)).data;
        let n = b.solved.size();
        let elapsed = request.time.toMillis() - a.startedAt.toMillis();
        let expired = elapsed >= timedDuration(a.type) || request.time.toMillis() >= p.closesAt;
        return allowed(b) && !a.done && b.day == a.day && b.type == a.type && b.person == a.person && b.startedAt == a.startedAt && b.total == a.total && b.closesAt == a.closesAt
          && (expired
            ? b.done && !b.complete && b.finishedAt == request.time && b.solved == a.solved && b.foundAt == a.foundAt
            : n == a.solved.size()+1 && b.solved[n-1] is int && b.solved[n-1] >= 0 && b.solved[n-1] < p.entries.size()
              && b.solved.toSet().size() == n && samePrefix(a.solved,b.solved) && samePrefix(a.foundAt,b.foundAt)
              && b.foundAt[n-1] is int && b.foundAt[n-1] >= 0 && b.foundAt[n-1] <= elapsed + 5000
              && b.done == (n == p.entries.size()) && b.complete == b.done
              && (b.done ? b.finishedAt == request.time : b.finishedAt == null));
      }
      function ended(g) { return g.done || request.time.toMillis() >= g.startedAt.toMillis() + timedDuration(g.type) || request.time.toMillis() >= g.closesAt; }
      function peek() {
        let own = get(/databases/$(database)/documents/households/$(householdId)/timedGames/$(resource.data.day + '-' + resource.data.type + '-' + mySide())).data;
        return ended(resource.data) && ended(own);
      }
      allow get: if inHousehold(householdId) && (id.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}(-tie-[0-9]+)?-(search|crossword)-' + mySide()) || peek());
      allow list: if inHousehold(householdId) && resource.data.person == mySide();
      allow create: if inHousehold(householdId) && start(request.resource.data);
      allow update: if inHousehold(householdId) && move(resource.data,request.resource.data);
      allow delete: if false;
    }
    match /households/{householdId}/timedResults/{id} {
      function summary(g) {
        let game = getAfter(/databases/$(database)/documents/households/$(householdId)/timedGames/$(id)).data;
        return g.keys().hasOnly(['day','type','person','startedAt','finishedAt','done','complete','count','total','closesAt'])
          && g.person == mySide() && id == g.day + '-' + g.type + '-' + mySide()
          && g.day == game.day && g.type == game.type && g.person == game.person
          && g.startedAt == game.startedAt && g.finishedAt == game.finishedAt
          && g.done == game.done && g.complete == game.complete && g.count == game.solved.size() && g.total == game.total && g.closesAt == game.closesAt;
      }
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId) && summary(request.resource.data);
      allow delete: if false;
    }
    match /households/{householdId}/activityEvents/{id} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId) && request.resource.data.keys().hasOnly(['day','createdAt'])
        && request.resource.data.day is string && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }
    function validLeagueScores(g) {
      return g.format == 'trio' && g.scores is map && g.scores.keys().hasOnly(['her','him'])
        && g.scores.her is int && g.scores.him is int && g.scores.her >= 0 && g.scores.him >= 0
        && g.round is int && g.round >= 0 && g.round <= 1000000
        && g.scoreVersion == 2 && g.scores.her <= 1600 + 400*g.round && g.scores.him <= 1600 + 400*g.round;
    }
    // Immutable settlement/event records. Like question opening, the delivery
    // Worker uses the existing household member credential, not an admin key.
    function validWordScores(scores) {
      return scores is map && scores.keys().hasOnly(['her','him'])
        && scores.her is int && scores.him is int
        && scores.her >= 0 && scores.her <= 80 && scores.him >= 0 && scores.him <= 80;
    }
    function validScaledWordScores(g) {
      return g.get('scoreVersion',1) == 2 && g.get('format','word') == 'word'
        && g.scores.keys().hasOnly(['her','him']) && g.scores.her is int && g.scores.him is int
        && g.scores.her >= 0 && g.scores.her <= 800 && g.scores.him >= 0 && g.scores.him <= 800;
    }
    match /households/{householdId}/wordWeeks/{week} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId) && request.resource.data.week == week
        && week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (validWordScores(request.resource.data.scores) || validScaledWordScores(request.resource.data) || validLeagueScores(request.resource.data)) && request.resource.data.winners is list
        && request.resource.data.winners.size() <= 1
        && request.resource.data.winners.hasOnly(['her','him']) && request.resource.data.settledAt is int;
      allow update, delete: if false;
    }
    match /households/{householdId}/wordDuels/{id} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId) && request.resource.data.puzzleId == id
        && request.resource.data.week is string && request.resource.data.round is int
        && request.resource.data.round > 0 && (validWordScores(request.resource.data.scores) || validScaledWordScores(request.resource.data) || validLeagueScores(request.resource.data))
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }
    match /households/{householdId}/wordDuelEnds/{id} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId) && request.resource.data.outcome in ['her','him','tie']
        && request.resource.data.closedAt is int && request.resource.data.week is string;
      allow update, delete: if false;
    }

    match /households/{householdId}/questions/{day} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.day == day
        && request.resource.data.promptId is int
        && request.resource.data.promptId >= 0 && request.resource.data.promptId < 150
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().size() == 0
        && request.resource.data.openedAt is int;
      allow update: if inHousehold(householdId)
        && request.resource.data.day == resource.data.day
        && request.resource.data.promptId == resource.data.promptId
        && (!resource.data.keys().hasAny(['closesAt']) || request.time.toMillis() < resource.data.closesAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])
        && request.resource.data.answers.diff(resource.data.answers).affectedKeys().hasOnly([mySide()])
        && request.resource.data.answers[mySide()].keys().hasOnly(['at'])
        && request.resource.data.answers[mySide()].at is int
        && existsAfter(/databases/$(database)/documents/households/$(householdId)/questionAnswers/$(day + '-' + mySide()));
      allow delete: if false;
    }

    // Words are separate from the shared question marker. Firestore cannot
    // hide individual fields of a readable document; separating the answers
    // makes "no peeking until both answer" an actual database rule.
    match /households/{householdId}/questionAnswers/{answerId} {
      allow get: if inHousehold(householdId)
        && (resource.data.person == mySide()
          || (get(/databases/$(database)/documents/households/$(householdId)/questions/$(resource.data.day)).data.answers.her.at is int
            && get(/databases/$(database)/documents/households/$(householdId)/questions/$(resource.data.day)).data.answers.him.at is int));
      allow list: if false;
      allow create, update: if inHousehold(householdId)
        && request.resource.data.person == mySide()
        && request.resource.data.day is string
        && answerId == request.resource.data.day + '-' + mySide()
        && request.resource.data.keys().hasOnly(['day', 'person', 'text', 'at'])
        && shortText(request.resource.data.text, 240)
        && (!get(/databases/$(database)/documents/households/$(householdId)/questions/$(request.resource.data.day)).data.keys().hasAny(['closesAt'])
          || request.time.toMillis() < get(/databases/$(database)/documents/households/$(householdId)/questions/$(request.resource.data.day)).data.closesAt)
        && request.resource.data.at is int
        && (resource == null || (request.resource.data.person == resource.data.person
          && request.resource.data.day == resource.data.day));
      allow delete: if false;
    }

    match /households/{householdId}/questionEvents/{eventId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && eventId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}-(open|answered|reveal)')
        && request.resource.data.day is string
        && request.resource.data.event in ['open', 'answered', 'reveal']
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    match /households/{householdId}/memoryPhotos/{memoryId} {
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.addedBy == mySide()
        && request.resource.data.createdAt is int
        && shortText(request.resource.data.photo, 650000);
      allow update: if inHousehold(householdId)
        && resource.data.addedBy == mySide()
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && shortText(request.resource.data.photo, 650000);
      allow delete: if inHousehold(householdId);
    }

    match /households/{householdId}/reactions/{reactionId} {
      allow read: if inHousehold(householdId);
      allow create, update: if inHousehold(householdId)
        && request.resource.data.by == mySide()
        && request.resource.data.to == otherSide()
        && request.resource.data.targetType in ['note', 'status']
        && shortText(request.resource.data.targetId, 180)
        && shortText(request.resource.data.emoji, 32)
        && request.resource.data.createdAt is int;
      allow delete: if inHousehold(householdId);
    }

    // One board, one confirmed move per turn. A transaction writes the move
    // and its ping together; stale clients cannot replace a partner's square.
    match /households/{householdId}/games/{gameId} {
      function won(board, side) {
        let a = board.get('0','') == side;
        let b = board.get('1','') == side;
        let c = board.get('2','') == side;
        let d = board.get('3','') == side;
        let e = board.get('4','') == side;
        let f = board.get('5','') == side;
        let g = board.get('6','') == side;
        let h = board.get('7','') == side;
        let i = board.get('8','') == side;
        return (a && b && c) || (d && e && f) || (g && h && i)
          || (a && d && g) || (b && e && h) || (c && f && i)
          || (a && e && i) || (c && e && g);
      }
      function over(game) {
        return game.closed || game.ply >= 30 || won(game.board, game.lastBy);
      }
      function valid(game) {
        return game.keys().hasOnly(['round','board','turn','startedBy','lastBy','lastCell','fromCell','ply','score','wins','createdAt','updatedAt','closed'])
          && game.round is string && game.round.matches('[A-Za-z0-9_-]{1,80}')
          && game.board is map && game.board.keys().hasOnly(['0','1','2','3','4','5','6','7','8'])
          && game.turn in ['her','him'] && game.startedBy in ['her','him']
          && game.lastBy == mySide() && game.lastCell is string && game.fromCell is string
          && game.ply is int && game.ply >= 0 && game.ply <= 30
          && game.score is map && game.score.keys().hasOnly(['her','him'])
          && game.score.her is int && game.score.him is int
          && game.score.her >= 0 && game.score.her <= 3 && game.score.him >= 0 && game.score.him <= 3
          && game.wins is map && game.wins.keys().hasOnly(['her','him'])
          && game.wins.her is int && game.wins.him is int && game.wins.her >= 0 && game.wins.him >= 0
          && game.createdAt is int && game.updatedAt is int && game.closed is bool;
      }
      function newRound(game) {
        return game.board.size() == 0 && !game.closed && game.startedBy == mySide()
          && game.lastCell == '' && game.fromCell == '' && game.ply == 0 && game.turn == otherSide();
      }
      function scores(before, after) {
        let me = mySide();
        let other = otherSide();
        let point = won(after.board, me) ? 1 : 0;
        return after.score[me] == before.score[me] + point
          && after.score[other] == before.score[other]
          && after.wins[me] == before.wins[me] + (point == 1 && after.score[me] == 3 ? 1 : 0)
          && after.wins[other] == before.wins[other];
      }
      function move(before, after) {
        let shifting = before.board.values().removeAll([otherSide()]).size() == 3;
        return !over(before) && before.turn == mySide() && after.turn == otherSide()
          && after.diff(before).affectedKeys().hasOnly(['board','turn','lastBy','lastCell','fromCell','ply','score','wins','updatedAt'])
          && after.ply == before.ply + 1 && scores(before, after)
          && after.lastCell.matches('[0-8]') && !before.board.keys().hasAny([after.lastCell])
          && (shifting
            ? (after.fromCell.matches('[0-8]') && before.board.get(after.fromCell, '') == mySide()
              && !after.board.keys().hasAny([after.fromCell])
              && after.board.diff(before.board).affectedKeys().hasOnly([after.lastCell,after.fromCell])
              && after.board.size() == before.board.size())
            : (after.fromCell == '' && after.board.diff(before.board).affectedKeys().hasOnly([after.lastCell])
              && after.board.size() == before.board.size() + 1))
          && after.board[after.lastCell] == mySide();
      }
      allow read: if inHousehold(householdId);
      allow create: if inHousehold(householdId) && gameId == 'sun-moon'
        && valid(request.resource.data) && newRound(request.resource.data)
        && request.resource.data.score == {'her':0,'him':0} && request.resource.data.wins == {'her':0,'him':0};
      allow update: if inHousehold(householdId) && gameId == 'sun-moon' && valid(request.resource.data)
        && (move(resource.data, request.resource.data)
          || (!over(resource.data) && request.resource.data.closed
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed','lastBy','updatedAt']))
          || (over(resource.data) && request.resource.data.round != resource.data.round && newRound(request.resource.data)
            && request.resource.data.wins == resource.data.wins
            && request.resource.data.score == (resource.data.score.her == 3 || resource.data.score.him == 3 ? {'her':0,'him':0} : resource.data.score)));
      allow delete: if false;
    }

    // The arcade boards are independent of the original three-piece game.
    // Winner/box ownership is derived again here, not trusted from the client.
    match /households/{householdId}/games/{gameId} {
      function arcadeValid(g) {
        return gameId in ['connect-four','dots-boxes'] && g.mode == gameId
          && g.keys().hasOnly(['mode','round','board','boxes','winner','turn','startedBy','lastBy','lastCell','ply','score','wins','createdAt','updatedAt','closed'])
          && g.round is string && g.round.matches('[A-Za-z0-9_-]{1,80}')
          && g.board is map && g.boxes is map
          && g.boxes.keys().hasOnly(['0','1','2','3','4','5','6','7','8'])
          && g.boxes.values().hasOnly(['her','him'])
          && g.winner in ['','her','him'] && g.turn in ['her','him'] && g.startedBy in ['her','him'] && g.lastBy == mySide()
          && g.lastCell is int && g.ply is int && g.ply >= 0 && g.ply <= (gameId == 'connect-four' ? 42 : 24)
          && g.score is map && g.score.keys().hasOnly(['her','him'])
          && g.score.her is int && g.score.him is int && g.score.her >= 0 && g.score.her <= 3 && g.score.him >= 0 && g.score.him <= 3
          && g.wins is map && g.wins.keys().hasOnly(['her','him'])
          && g.wins.her is int && g.wins.him is int && g.wins.her >= 0 && g.wins.him >= 0
          && g.createdAt is int && g.updatedAt is int && g.closed is bool;
      }
      function arcadeOver(g) { return g.closed || g.winner != '' || g.ply >= (g.mode == 'connect-four' ? 42 : 24); }
      function arcadeStart(g) {
        return g.board.size() == 0 && g.boxes.size() == 0 && g.winner == '' && g.ply == 0 && g.lastCell == -1
          && !g.closed && g.startedBy == mySide() && g.turn == otherSide();
      }
      function fourThrough(b, cell, step, back, forward, side) {
        let b1 = back >= 1 && b.get(string(cell-step),'') == side;
        let b2 = b1 && back >= 2 && b.get(string(cell-step*2),'') == side;
        let b3 = b2 && back >= 3 && b.get(string(cell-step*3),'') == side;
        let f1 = forward >= 1 && b.get(string(cell+step),'') == side;
        let f2 = f1 && forward >= 2 && b.get(string(cell+step*2),'') == side;
        let f3 = f2 && forward >= 3 && b.get(string(cell+step*3),'') == side;
        return b3 || (b2 && f1) || (b1 && f2) || f3;
      }
      function fourWon(g) {
        let r = int(g.lastCell / 7);
        let c = g.lastCell%7;
        let side = mySide();
        return fourThrough(g.board,g.lastCell,1,c,6-c,side)
          || fourThrough(g.board,g.lastCell,7,r,5-r,side)
          || fourThrough(g.board,g.lastCell,8,r<c?r:c,5-r<6-c?5-r:6-c,side)
          || fourThrough(g.board,g.lastCell,6,r<6-c?r:6-c,5-r<c?5-r:c,side);
      }
      function fourMove(before, after) {
        return after.lastCell >= 0 && after.lastCell < 42 && after.boxes.size() == 0 && after.turn == otherSide()
          && (after.lastCell >= 35 || before.board.get(string(after.lastCell+7),'') != '')
          && after.winner == (after.ply >= 7 && fourWon(after) ? mySide() : '');
      }
      function boxValid(before, after, index) {
        let key = string(index);
        let left = 12 + int(index / 3)*4 + index%3;
        let was = before.boxes.get(key,'');
        let complete = after.board.keys().hasAll([key,string(index+3),string(left),string(left+1)]);
        return index == -1 || after.boxes.get(key,'') == (was != '' ? was : complete ? mySide() : '');
      }
      function boxesMove(before, after) {
        let edge = after.lastCell;
        let row = int((edge-12) / 4);
        let col = (edge-12)%4;
        let first = edge < 12 ? (edge >= 3 ? edge-3 : -1) : (col > 0 ? row*3+col-1 : -1);
        let second = edge < 12 ? (edge < 9 ? edge : -1) : (col < 3 ? row*3+col : -1);
        let her = after.boxes.values().removeAll(['him']).size();
        let winner = after.ply == 24 ? (her >= 5 ? 'her' : 'him') : '';
        return after.lastCell >= 0 && after.lastCell < 24 && after.winner == winner
          && after.boxes.keys().hasOnly(['0','1','2','3','4','5','6','7','8']) && after.boxes.values().hasOnly(['her','him'])
          && after.turn == (after.boxes.size() > before.boxes.size() ? mySide() : otherSide())
          && after.boxes.diff(before.boxes).affectedKeys().hasOnly([string(first),string(second)])
          && boxValid(before,after,first) && boxValid(before,after,second);
      }
      function arcadeScores(before, after) {
        let sun = after.winner == 'her' ? 1 : 0;
        let moon = after.winner == 'him' ? 1 : 0;
        return after.score.keys().hasOnly(['her','him']) && after.wins.keys().hasOnly(['her','him'])
          && after.score.her == before.score.her + sun && after.score.him == before.score.him + moon
          && after.wins.her == before.wins.her + (sun == 1 && after.score.her == 3 ? 1 : 0)
          && after.wins.him == before.wins.him + (moon == 1 && after.score.him == 3 ? 1 : 0);
      }
      function arcadeMove(before, after) {
        let key = string(after.lastCell);
        return !arcadeOver(before) && before.turn == mySide() && after.lastCell is int
          && after.diff(before).affectedKeys().hasOnly(['board','boxes','winner','turn','lastBy','lastCell','ply','score','wins','updatedAt'])
          && after.ply == before.ply+1 && !before.board.keys().hasAny([key])
          && after.board.diff(before.board).affectedKeys().hasOnly([key])
          && after.board.size() == before.board.size()+1 && after.board[key] == mySide()
          && (gameId == 'connect-four' ? fourMove(before,after) : boxesMove(before,after))
          && arcadeScores(before,after);
      }
      allow create: if inHousehold(householdId) && arcadeValid(request.resource.data) && arcadeStart(request.resource.data)
        && request.resource.data.score == {'her':0,'him':0} && request.resource.data.wins == {'her':0,'him':0};
      allow update: if inHousehold(householdId) && gameId in ['connect-four','dots-boxes']
        && request.resource.data.lastBy == mySide() && request.resource.data.updatedAt is int
        && (arcadeMove(resource.data,request.resource.data)
          || (!arcadeOver(resource.data) && request.resource.data.closed
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed','lastBy','updatedAt']))
          || (arcadeOver(resource.data) && arcadeValid(request.resource.data) && request.resource.data.round != resource.data.round && arcadeStart(request.resource.data)
            && request.resource.data.wins == resource.data.wins
            && request.resource.data.score == (resource.data.score.her == 3 || resource.data.score.him == 3 ? {'her':0,'him':0} : resource.data.score)));
    }

    match /households/{householdId}/outbox/{messageId} {
      allow read, delete: if inHousehold(householdId);
      allow create: if inHousehold(householdId)
        && request.resource.data.to in ['her', 'him']
        && shortText(request.resource.data.title, 120)
        && shortText(request.resource.data.body, 400)
        && shortText(request.resource.data.url, 200)
        && shortText(request.resource.data.kind, 60)
        && (!request.resource.data.keys().hasAny(['ref']) || shortText(request.resource.data.ref, 200))
        && (!request.resource.data.keys().hasAny(['urgent']) || request.resource.data.urgent is bool)
        && request.resource.data.sendAt is int
        && request.resource.data.createdAt is int;
      // The delivery worker defers low-priority messages until focus ends.
      // It signs in as a member, and may only move the delivery time forward.
      allow update: if inHousehold(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sendAt'])
        && request.resource.data.sendAt is int
        && request.resource.data.sendAt >= resource.data.sendAt
        && request.resource.data.sendAt <= request.time.toMillis() + 86400000;
    }

    match /households/{householdId}/deliveryLocks/{lockId} {
      allow read, create, delete: if inHousehold(householdId);
      allow update: if false;
    }

    match /households/{householdId}/migrations/{migrationId} {
      allow read, create: if inHousehold(householdId);
      allow update, delete: if false;
    }
  }
}
